#: prefs.js:16
msgid "Settings"
msgstr "Definições"

#: prefs.js:23
msgid "Support App Uninstaller"
msgstr "Apoie a extensão App Uninstaller"

#: prefs.js:24
msgid "Your donation helps maintain and improve the extension."
msgstr "O seu donativo ajuda a manter e melhorar a extensão."

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "Ofereça-me um café"

#: prefs.js:40
msgid "App menu"
msgstr "Menu da aplicação"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "Mostrar a origem no menu"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "Por exemplo: «Desinstalar (Flatpak)»."

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "Ocultar a opção quando não for possível desinstalar"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "Se estiver visível, a opção explica por que motivo não é possível remover a aplicação."

#: prefs.js:53
msgid "Menu item position"
msgstr "Posição da opção no menu"

#: prefs.js:54
msgid "Before app details"
msgstr "Antes dos detalhes da aplicação"

#: prefs.js:54
msgid "At the bottom"
msgstr "No fim do menu"

#: prefs.js:63
msgid "Confirmation"
msgstr "Confirmação"

#: prefs.js:67
msgid "Ask before uninstalling"
msgstr "Pedir confirmação antes de desinstalar"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "Mostrar os pacotes afetados"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "O APT e o Pacman mostram o que também será removido. O RPM mostra os pacotes que dependem da aplicação."

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "Mostrar os comandos na janela de confirmação"

#: prefs.js:76
msgid "Uninstall options"
msgstr "Opções de desinstalação"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "Pode alterar estas opções sempre que confirmar uma desinstalação."

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "Mover os ficheiros AppImage para o lixo"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "Permitir a remoção de atalhos locais"

#: prefs.js:89
msgid "This only removes the shortcut for apps such as Wine or browser apps."
msgstr "Para aplicações do Wine ou do navegador, só é removido o atalho."

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "Retirar dos favoritos após desinstalar"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "Mostrar o progresso e a conclusão da desinstalação"

#: prefs.js:97
msgid "Safety"
msgstr "Segurança"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "Proteger os componentes essenciais do sistema"

#: prefs.js:112
msgid "Protected apps"
msgstr "Aplicações protegidas"

#: prefs.js:113
msgid "Enter a package name, a Flatpak or Snap ID, or a .desktop filename."
msgstr "Introduza o nome de um pacote, um ID do Flatpak ou Snap ou o nome de um ficheiro .desktop."

#: prefs.js:117
msgid "Add an app to protect"
msgstr "Adicionar uma aplicação a proteger"

#: prefs.js:122
msgid "Add"
msgstr "Adicionar"

#: prefs.js:138
msgid "Remove"
msgstr "Retirar"

