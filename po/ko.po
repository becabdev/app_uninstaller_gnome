msgid "Uninstall"
msgstr "제거"

#: extension.js:248
msgid "Uninstall (unavailable)"
msgstr "제거(사용 불가)"

#: extension.js:252
msgid "Uninstall ({0})"
msgstr "제거({0})"

#: extension.js:269 sources.js:76
msgid "Unknown source"
msgstr "알 수 없는 설치 출처"

#: extension.js:271
msgid "Detection error: {0}"
msgstr "설치 출처 확인 오류: {0}"

#: extension.js:281 sources.js:549
msgid "This installation source is unsupported."
msgstr "이 설치 출처는 지원하지 않습니다."

#: extension.js:291
msgid "Local launcher removal is off in Settings."
msgstr "설정에서 로컬 바로 가기 제거를 껐습니다."

#: extension.js:296
msgid "System launcher removal is off in Settings."
msgstr "설정에서 시스템 바로 가기 제거를 껐습니다."

#: extension.js:309
msgid "This app is already being uninstalled."
msgstr "이 앱은 이미 제거 중입니다."

#: extension.js:319 extension.js:535
msgid "Cannot uninstall “{0}”"
msgstr "‘{0}’을(를) 제거할 수 없음"

#: extension.js:357
msgid "Uninstall “{0}”?"
msgstr "‘{0}’을(를) 제거할까요?"

#: extension.js:374
msgid "Administrator approval is required."
msgstr "관리자 승인이 필요합니다."

#: extension.js:381
msgid "Checking affected packages…"
msgstr "영향을 받는 패키지를 확인하는 중…"

#: extension.js:390
msgid "Dependent packages that may be removed ({0})"
msgstr "이 패키지에 의존하며 함께 제거될 수 있는 패키지({0}개)"

#: extension.js:391
msgid "Other packages to be removed ({0})"
msgstr "함께 제거할 다른 패키지({0}개)"

#: extension.js:397
msgid "Commands:"
msgstr "명령:"

#: extension.js:438 prefs.js:82
msgid "Also delete data and settings"
msgstr "데이터와 설정도 삭제"

#: extension.js:450 prefs.js:84
msgid "Also remove unused dependencies"
msgstr "사용하지 않는 의존 패키지도 제거"

#: extension.js:475
msgid "Cancel"
msgstr "취소"

#: extension.js:492 extension.js:568
msgid "Failed to uninstall “{0}”"
msgstr "‘{0}’ 제거 실패"

#: extension.js:514
msgid "Authentication cancelled or denied."
msgstr "인증이 취소되었거나 거부되었습니다."

#: extension.js:515
msgid "exit code {0}"
msgstr "종료 코드 {0}"

#: extension.js:552
msgid "Uninstalling “{0}”…"
msgstr "‘{0}’ 제거 중…"

#: extension.js:569
msgid "Unknown error."
msgstr "알 수 없는 오류입니다."

#: extension.js:582
msgid "“{0}” still appears to be installed"
msgstr "‘{0}’이(가) 아직 설치되어 있는 것으로 보입니다"

#: extension.js:583
msgid "The launcher is still present. Check the installation source."
msgstr "바로 가기가 남아 있습니다. 설치 출처를 확인하세요."

#: extension.js:589
msgid "“{0}” uninstalled"
msgstr "‘{0}’ 제거 완료"

#: extension.js:590
msgid "Restart to apply the change."
msgstr "변경 사항을 적용하려면 다시 시작하세요."

#: prefs.js:16
msgid "Settings"
msgstr "설정"

#: prefs.js:23
msgid "Support App Uninstaller"
msgstr "App Uninstaller 후원하기"

#: prefs.js:24
msgid "Your donation helps maintain and improve the extension."
msgstr "후원금은 확장 기능의 유지보수와 개선에 쓰입니다."

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "커피 한 잔 사 주기"

#: prefs.js:40
msgid "App menu"
msgstr "앱 메뉴"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "메뉴에 설치 출처 표시"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "예: ‘제거(Flatpak)’"

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "제거할 수 없으면 메뉴 항목 숨기기"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "항목을 표시하면 선택했을 때 제거할 수 없는 이유를 보여 줍니다."

#: prefs.js:53
msgid "Menu item position"
msgstr "메뉴 항목 위치"

#: prefs.js:54
msgid "Before app details"
msgstr "앱 상세 정보 위"

#: prefs.js:54
msgid "At the bottom"
msgstr "메뉴 맨 아래"

#: prefs.js:63
msgid "Confirmation"
msgstr "확인"

#: prefs.js:67
msgid "Ask before uninstalling"
msgstr "제거 전에 묻기"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "영향을 받는 패키지 미리 보기"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "APT와 Pacman은 함께 제거할 패키지를 보여 줍니다. RPM은 이 앱에 의존하는 패키지를 보여 줍니다."

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "확인 창에 명령 표시"

#: prefs.js:76
msgid "Uninstall options"
msgstr "제거 옵션"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "제거를 확인할 때마다 옵션을 바꿀 수 있습니다."

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "AppImage 파일을 휴지통으로 이동"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "로컬 바로 가기 제거 허용"

#: prefs.js:89
msgid "This only removes the shortcut for apps such as Wine or browser apps."
msgstr "Wine 앱이나 브라우저 앱의 경우 바로 가기만 제거합니다."

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "제거한 앱을 즐겨찾기에서 삭제"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "제거 진행 상황과 완료 알림 표시"

#: prefs.js:97
msgid "Safety"
msgstr "안전"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "필수 시스템 구성 요소 보호"

#: prefs.js:112
msgid "Protected apps"
msgstr "보호된 앱"

#: prefs.js:113
msgid "Enter a package name, a Flatpak or Snap ID, or a .desktop filename."
msgstr "패키지 이름, Flatpak 또는 Snap ID, .desktop 파일 이름 중 하나를 입력하세요."

#: prefs.js:117
msgid "Add an app to protect"
msgstr "보호할 앱 추가"

#: prefs.js:122
msgid "Add"
msgstr "추가"

#: prefs.js:138
msgid "Remove"
msgstr "목록에서 빼기"

