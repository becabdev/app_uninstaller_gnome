msgstr "Waydroid (تطبيق أندرويد)"

#: sources.js:317
msgid "Waydroid was not found."
msgstr "لم يُعثر على Waydroid."

#: sources.js:327
msgid "Container “{0}” (Distrobox or Toolbox)"
msgstr "الحاوية «{0}» (Distrobox أو Toolbox)"

#: sources.js:330
msgid "The launcher is not in your home directory."
msgstr "الاختصار ليس في مجلدك الشخصي."

#: sources.js:356
msgid "NixOS configuration"
msgstr "تهيئة NixOS"

#: sources.js:357
msgid "Remove this app from your NixOS configuration and rebuild the system."
msgstr "أزِل هذا التطبيق من تهيئة NixOS ثم أعِد بناء النظام."

#: sources.js:360
msgid "Could not find nix or nix-env."
msgstr "لم يُعثر على nix أو nix-env."

#: sources.js:372
msgid "Guix was not found."
msgstr "لم يُعثر على Guix."

#: sources.js:380
msgid "Local launcher"
msgstr "اختصار محلي"

#: sources.js:405
msgid "{0} package"
msgstr "حزمة {0}"

#: sources.js:408
msgid "Could not find a compatible package manager."
msgstr "لم يُعثر على مدير حزم متوافق."

#: sources.js:422 sources.js:425
msgid "Manual installation"
msgstr "تثبيت يدوي"

#: sources.js:423 sources.js:539
msgid "Run the vendor uninstaller yourself: {0}"
msgstr "شغّل أداة الإزالة التي وفّرها المطوّر يدويًا: {0}"

#: sources.js:449
msgid "This app is on your protected list."
msgstr "هذا التطبيق ضمن قائمة التطبيقات المحمية."

#: sources.js:451
msgid "System protection is on for this component."
msgstr "حماية النظام مفعّلة لهذا المكوّن."

#: sources.js:463
msgid "Could not find a system copy of pkexec."
msgstr "لم يُعثر على نسخة موثوقة من pkexec في النظام."

#: sources.js:469
msgid "Could not find a system copy of {0}."
msgstr "لم يُعثر على نسخة موثوقة من {0} في النظام."

#: sources.js:490
msgid "Invalid package or app ID."
msgstr "معرّف الحزمة أو التطبيق غير صالح."

#: sources.js:511
msgid "Confirm the uninstall in Steam."
msgstr "أكّد الإزالة في Steam."

#: sources.js:522
msgid "For packages managed by Home Manager, edit your configuration."
msgstr "عدّل إعدادات Home Manager لإزالة الحزم التي يديرها."

#: sources.js:535
msgid "Only the launcher will be removed. The app stays in the container."
msgstr "سيُحذف الاختصار فقط. سيبقى التطبيق في الحاوية."

#: sources.js:541
msgid "The system launcher cannot be removed safely."
msgstr "لا يمكن إزالة اختصار النظام هذا بأمان."

#: sources.js:578
msgid "Restart to apply the change. Packages in the base image stay installed."
msgstr "أعِد التشغيل لتطبيق التغيير. ستبقى حزم صورة النظام الأساسية مثبّتة."

#: sources.js:593
msgid "Unsupported package manager."
msgstr "مدير الحزم غير مدعوم."

