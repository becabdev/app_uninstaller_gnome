#: extension.js:484
msgid "Uninstall"
msgstr "إزالة التطبيق"

#: extension.js:248
msgid "Uninstall (unavailable)"
msgstr "إزالة التطبيق (غير متاحة)"

#: extension.js:252
msgid "Uninstall ({0})"
msgstr "إزالة التطبيق ({0})"

#: extension.js:269 sources.js:76
msgid "Unknown source"
msgstr "مصدر غير معروف"

#: extension.js:271
msgid "Detection error: {0}"
msgstr "تعذّر تحديد المصدر: {0}"

#: extension.js:281 sources.js:549
msgid "This installation source is unsupported."
msgstr "مصدر التثبيت هذا غير مدعوم."

#: extension.js:291
msgid "Local launcher removal is off in Settings."
msgstr "إزالة الاختصارات المحلية معطّلة في الإعدادات."

#: extension.js:296
msgid "System launcher removal is off in Settings."
msgstr "إزالة اختصارات النظام معطّلة في الإعدادات."

#: extension.js:309
msgid "This app is already being uninstalled."
msgstr "تجري إزالة هذا التطبيق بالفعل."

#: extension.js:319 extension.js:535
msgid "Cannot uninstall “{0}”"
msgstr "تعذّرت إزالة «{0}»"

#: extension.js:357
msgid "Uninstall “{0}”?"
msgstr "هل تريد إزالة «{0}»؟"

#: extension.js:374
msgid "Administrator approval is required."
msgstr "يلزم إذن المسؤول."

#: extension.js:381
msgid "Checking affected packages…"
msgstr "جارٍ التحقق من الحزم المتأثرة…"

#: extension.js:390
msgid "Dependent packages that may be removed ({0})"
msgstr "الحزم التابعة التي قد تُزال ({0})"

#: extension.js:391
msgid "Other packages to be removed ({0})"
msgstr "حزم أخرى ستُزال ({0})"

#: extension.js:397
msgid "Commands:"
msgstr "الأوامر:"

#: extension.js:438 prefs.js:82
msgid "Also delete data and settings"
msgstr "احذف البيانات والإعدادات أيضًا"

#: extension.js:450 prefs.js:84
msgid "Also remove unused dependencies"
msgstr "أزل التبعيات غير المستخدمة أيضًا"

#: extension.js:475
msgid "Cancel"
msgstr "إلغاء"

#: extension.js:492 extension.js:568
msgid "Failed to uninstall “{0}”"
msgstr "فشلت إزالة «{0}»"

#: extension.js:514
msgid "Authentication cancelled or denied."
msgstr "أُلغي الاستيثاق أو رُفض."

#: extension.js:515
msgid "exit code {0}"
msgstr "رمز الخروج {0}"

#: extension.js:552
msgid "Uninstalling “{0}”…"
msgstr "جارٍ إزالة «{0}»…"

#: extension.js:569
msgid "Unknown error."
msgstr "خطأ غير معروف."

#: extension.js:582
msgid "“{0}” still appears to be installed"
msgstr "يبدو أن «{0}» لا يزال مثبّتًا"

#: extension.js:583
msgid "The launcher is still present. Check the installation source."
msgstr "لا يزال الاختصار موجودًا. تحقّق من مصدر التثبيت."

#: extension.js:589
msgid "“{0}” uninstalled"
msgstr "أُزيل «{0}»"

#: extension.js:590
msgid "Restart to apply the change."
msgstr "أعِد التشغيل لتطبيق التغيير."

#: prefs.js:16
msgid "Settings"
msgstr "الإعدادات"

#: prefs.js:23
msgid "Support App Uninstaller"
msgstr "ادعم App Uninstaller"

#: prefs.js:24
msgid "Your donation helps maintain and improve the extension."
msgstr "يساعد تبرعك في صيانة الامتداد وتحسينه."

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "أهدني فنجان قهوة"

#: prefs.js:40
msgid "App menu"
msgstr "قائمة التطبيق"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "أظهر مصدر التثبيت في القائمة"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "مثل «إزالة التطبيق (Flatpak)»."

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "أخفِ خيار القائمة عند تعذّر الإزالة"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "إن ظهر الخيار، يمكنك اختياره لمعرفة سبب تعذّر إزالة التطبيق."

#: prefs.js:53
msgid "Menu item position"
msgstr "موضع الخيار في القائمة"

#: prefs.js:54
msgid "Before app details"
msgstr "قبل تفاصيل التطبيق"

#: prefs.js:54
msgid "At the bottom"
msgstr "أسفل القائمة"

#: prefs.js:63
msgid "Confirmation"
msgstr "التأكيد"

#: prefs.js:67
msgid "Ask before uninstalling"
msgstr "اطلب التأكيد قبل الإزالة"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "اعرض الحزم المتأثرة قبل الإزالة"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "تعرض APT وPacman ما سيُزال أيضًا. وتعرض RPM الحزم التي تعتمد على التطبيق."

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "أظهر الأوامر في نافذة التأكيد"

#: prefs.js:76
msgid "Uninstall options"
msgstr "خيارات الإزالة"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "يمكنك تعديل خيارات الإزالة عند كل تأكيد."

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "انقل ملفات AppImage إلى المهملات"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "اسمح بإزالة الاختصارات المحلية"

#: prefs.js:89
msgid "This only removes the shortcut for apps such as Wine or browser apps."
msgstr "يُحذف الاختصار فقط في تطبيقات Wine أو تطبيقات المتصفح مثلًا."

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "أزل التطبيق من المفضلة بعد إزالته"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "أظهر تقدّم الإزالة وعند اكتمالها"

#: prefs.js:97
msgid "Safety"
msgstr "الأمان"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "احمِ مكوّنات النظام الأساسية"

#: prefs.js:112
msgid "Protected apps"
msgstr "التطبيقات المحمية"

#: prefs.js:113
msgid "Enter a package name, a Flatpak or Snap ID, or a .desktop filename."
msgstr "أدخِل اسم حزمة أو معرّف Flatpak أو Snap أو اسم ملف ينتهي بالامتداد ‎.desktop‎."

#: prefs.js:117
msgid "Add an app to protect"
msgstr "أضف تطبيقًا لحمايته"

#: prefs.js:122
msgid "Add"
msgstr "إضافة"

#: prefs.js:138
msgid "Remove"
msgstr "إزالة من القائمة"

