msgid "The launcher is not in your home directory."
msgstr "ランチャーがホームフォルダーにありません。"

#: sources.js:356
msgid "NixOS configuration"
msgstr "NixOS の設定"

#: sources.js:357
msgid "Remove this app from your NixOS configuration and rebuild the system."
msgstr "NixOS の設定からこのアプリを外し、システムを再構築してください。"

#: sources.js:360
msgid "Could not find nix or nix-env."
msgstr "nix と nix-env のどちらも見つかりません。"

#: sources.js:372
msgid "Guix was not found."
msgstr "Guix が見つかりません。"

#: sources.js:380
msgid "Local launcher"
msgstr "ローカルランチャー"

#: sources.js:405
msgid "{0} package"
msgstr "{0} パッケージ"

#: sources.js:408
msgid "Could not find a compatible package manager."
msgstr "対応するパッケージマネージャーが見つかりません。"

#: sources.js:422 sources.js:425
msgid "Manual installation"
msgstr "手動インストール"

#: sources.js:423 sources.js:539
msgid "Run the vendor uninstaller yourself: {0}"
msgstr "提供元のアンインストーラーを手動で実行してください: {0}"

#: sources.js:449
msgid "This app is on your protected list."
msgstr "このアプリは保護リストにあります。"

#: sources.js:451
msgid "System protection is on for this component."
msgstr "このコンポーネントはシステム保護の対象です。"

#: sources.js:463
msgid "Could not find a system copy of pkexec."
msgstr "システムが提供する pkexec が見つかりません。"

#: sources.js:469
msgid "Could not find a system copy of {0}."
msgstr "システムが提供する {0} が見つかりません。"

#: sources.js:490
msgid "Invalid package or app ID."
msgstr "パッケージまたはアプリの ID が無効です。"

#: sources.js:511
msgid "Confirm the uninstall in Steam."
msgstr "Steam でアンインストールを確認してください。"

#: sources.js:522
msgid "For packages managed by Home Manager, edit your configuration."
msgstr "Home Manager が管理するパッケージは、設定を編集してください。"

#: sources.js:535
msgid "Only the launcher will be removed. The app stays in the container."
msgstr "ランチャーだけが削除されます。アプリはコンテナーに残ります。"

#: sources.js:541
msgid "The system launcher cannot be removed safely."
msgstr "このシステムランチャーは安全に削除できません。"

#: sources.js:578
msgid "Restart to apply the change. Packages in the base image stay installed."
msgstr "変更を適用するには再起動してください。ベースイメージのパッケージは残ります。"

#: sources.js:593
msgid "Unsupported package manager."
msgstr "このパッケージマネージャーには対応していません。"

