#: extension.js:49
msgid "container"
msgstr "コンテナー"

#: extension.js:50
msgid "local launcher"
msgstr "ローカルランチャー"

#: extension.js:51
msgid "manual installation"
msgstr "手動インストール"

#: extension.js:52
msgid "package"
msgstr "パッケージ"

#: extension.js:164 extension.js:169 extension.js:226 extension.js:252
#: extension.js:484
msgid "Uninstall"
msgstr "アンインストール"

#: extension.js:248
msgid "Uninstall (unavailable)"
msgstr "アンインストール（利用不可）"

#: extension.js:252
msgid "Uninstall ({0})"
msgstr "アンインストール（{0}）"

#: extension.js:269 sources.js:76
msgid "Unknown source"
msgstr "不明なインストール元"

#: extension.js:271
msgid "Detection error: {0}"
msgstr "検出エラー: {0}"

#: extension.js:281 sources.js:549
msgid "This installation source is unsupported."
msgstr "このインストール元には対応していません。"

#: extension.js:291
msgid "Local launcher removal is off in Settings."
msgstr "設定でローカルランチャーの削除が無効になっています。"

#: extension.js:296
msgid "System launcher removal is off in Settings."
msgstr "設定でシステムランチャーの削除が無効になっています。"

#: extension.js:309
msgid "This app is already being uninstalled."
msgstr "このアプリはすでにアンインストール中です。"

#: extension.js:319 extension.js:535
msgid "Cannot uninstall “{0}”"
msgstr "「{0}」をアンインストールできません"

#: extension.js:357
msgid "Uninstall “{0}”?"
msgstr "「{0}」をアンインストールしますか？"

#: extension.js:374
msgid "Administrator approval is required."
msgstr "管理者の承認が必要です。"

#: extension.js:381
msgid "Checking affected packages…"
msgstr "影響を受けるパッケージを確認中…"

#: extension.js:390
msgid "Dependent packages that may be removed ({0})"
msgstr "削除される可能性がある依存元パッケージ（{0} 件）"

#: extension.js:391
msgid "Other packages to be removed ({0})"
msgstr "ほかに削除されるパッケージ（{0} 件）"

#: extension.js:397
msgid "Commands:"
msgstr "コマンド:"

#: extension.js:438 prefs.js:82
msgid "Also delete data and settings"
msgstr "データと設定も削除する"

#: extension.js:450 prefs.js:84
msgid "Also remove unused dependencies"
msgstr "未使用の依存パッケージも削除する"

#: extension.js:475
msgid "Cancel"
msgstr "キャンセル"

#: extension.js:492 extension.js:568
msgid "Failed to uninstall “{0}”"
msgstr "「{0}」のアンインストールに失敗しました"

#: extension.js:514
msgid "Authentication cancelled or denied."
msgstr "認証がキャンセルされたか、拒否されました。"

#: extension.js:515
msgid "exit code {0}"
msgstr "終了コード {0}"

#: extension.js:552
msgid "Uninstalling “{0}”…"
msgstr "「{0}」をアンインストール中…"

#: extension.js:569
msgid "Unknown error."
msgstr "不明なエラーが発生しました。"

#: extension.js:582
msgid "“{0}” still appears to be installed"
msgstr "「{0}」はまだインストールされているようです"

#: extension.js:583
msgid "The launcher is still present. Check the installation source."
msgstr "ランチャーが残っています。インストール元を確認してください。"

#: extension.js:589
msgid "“{0}” uninstalled"
msgstr "「{0}」をアンインストールしました"

#: extension.js:590
msgid "Restart to apply the change."
msgstr "変更を適用するには再起動してください。"

#: prefs.js:16
msgid "Settings"
msgstr "設定"

#: prefs.js:23
msgid "Support App Uninstaller"
msgstr "App Uninstaller を応援"

#: prefs.js:24
msgid "Your donation helps maintain and improve the extension."
msgstr "寄付は拡張機能のメンテナンスと改善に役立ちます。"

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "コーヒーをおごる"

#: prefs.js:40
msgid "App menu"
msgstr "アプリメニュー"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "メニューにインストール元を表示する"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "例: 「アンインストール（Flatpak）」"

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "アンインストールできない場合はメニュー項目を非表示にする"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "表示した場合は、項目を選ぶと削除できない理由が表示されます。"

#: prefs.js:53
msgid "Menu item position"
msgstr "メニュー項目の位置"

#: prefs.js:54
msgid "Before app details"
msgstr "アプリの詳細の手前"

#: prefs.js:54
msgid "At the bottom"
msgstr "メニューの一番下"

#: prefs.js:63
msgid "Confirmation"
msgstr "確認"

#: prefs.js:67
msgid "Ask before uninstalling"
msgstr "アンインストールする前に確認する"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "影響を受けるパッケージを表示する"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "APT と Pacman では一緒に削除されるパッケージを表示します。RPM ではアプリに依存するパッケージを表示します。"

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "確認ダイアログにコマンドを表示する"

#: prefs.js:76
msgid "Uninstall options"
msgstr "アンインストールのオプション"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "アンインストールを確認するたびにオプションを変更できます。"

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "AppImage ファイルをゴミ箱に移動する"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "ローカルランチャーの削除を許可する"

#: prefs.js:89
msgid "This only removes the shortcut for apps such as Wine or browser apps."
msgstr "Wine やブラウザーのアプリなどは、ショートカットだけが削除されます。"

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "アンインストール後にお気に入りから外す"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "アンインストールの進行と完了を通知する"

#: prefs.js:97
msgid "Safety"
msgstr "安全対策"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "重要なシステムコンポーネントを保護する"

#: prefs.js:112
msgid "Protected apps"
msgstr "保護されたアプリ"

#: prefs.js:113
msgid "Enter a package name, a Flatpak or Snap ID, or a .desktop filename."
msgstr "パッケージ名、Flatpak や Snap の ID、または .desktop ファイル名を入力してください。"

#: prefs.js:117
msgid "Add an app to protect"
msgstr "保護するアプリを追加"

#: prefs.js:122
msgid "Add"
msgstr "追加"

#: prefs.js:138
msgid "Remove"
msgstr "一覧から削除"

