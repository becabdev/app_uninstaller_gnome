#: extension.js:281 sources.js:549
msgid "This installation source is unsupported."
msgstr "Questa origine di installazione non è supportata."

#: extension.js:291
msgid "Local launcher removal is off in Settings."
msgstr "La rimozione dei lanciatori locali è disattivata nelle impostazioni."

#: extension.js:296
msgid "System launcher removal is off in Settings."
msgstr "La rimozione dei lanciatori di sistema è disattivata nelle impostazioni."

#: extension.js:309
msgid "This app is already being uninstalled."
msgstr "Questa applicazione è già in fase di disinstallazione."

#: extension.js:319 extension.js:535
msgid "Cannot uninstall “{0}”"
msgstr "Impossibile disinstallare «{0}»"

#: extension.js:357
msgid "Uninstall “{0}”?"
msgstr "Disinstallare «{0}»?"

#: extension.js:374
msgid "Administrator approval is required."
msgstr "È necessaria l’autorizzazione di un amministratore."

#: extension.js:381
msgid "Checking affected packages…"
msgstr "Verifica dei pacchetti interessati…"

#: extension.js:390
msgid "Dependent packages that may be removed ({0})"
msgstr "Pacchetti dipendenti che potrebbero essere rimossi ({0})"

#: extension.js:391
msgid "Other packages to be removed ({0})"
msgstr "Altri pacchetti che verranno rimossi ({0})"

#: extension.js:397
msgid "Commands:"
msgstr "Comandi:"

#: extension.js:438 prefs.js:82
msgid "Also delete data and settings"
msgstr "Elimina anche i dati e le impostazioni"

#: extension.js:450 prefs.js:84
msgid "Also remove unused dependencies"
msgstr "Rimuovi anche le dipendenze inutilizzate"

#: extension.js:475
msgid "Cancel"
msgstr "Annulla"

#: extension.js:492 extension.js:568
msgid "Failed to uninstall “{0}”"
msgstr "Disinstallazione di «{0}» non riuscita"

#: extension.js:514
msgid "Authentication cancelled or denied."
msgstr "Autenticazione annullata o negata."

#: extension.js:515
msgid "exit code {0}"
msgstr "codice di uscita {0}"

