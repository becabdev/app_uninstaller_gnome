msgstr "Contenitore «{0}» (Distrobox o Toolbox)"

#: sources.js:330
msgid "The launcher is not in your home directory."
msgstr "Il lanciatore non si trova nella cartella personale."

#: sources.js:356
msgid "NixOS configuration"
msgstr "Configurazione di NixOS"

#: sources.js:357
msgid "Remove this app from your NixOS configuration and rebuild the system."
msgstr "Rimuovi l’applicazione dalla configurazione di NixOS e ricostruisci il sistema."

#: sources.js:360
msgid "Could not find nix or nix-env."
msgstr "Impossibile trovare nix o nix-env."

#: sources.js:372
msgid "Guix was not found."
