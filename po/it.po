msgstr "Impossibile trovare un gestore di pacchetti compatibile."

#: sources.js:422 sources.js:425
msgid "Manual installation"
msgstr "Installazione manuale"

#: sources.js:423 sources.js:539
msgid "Run the vendor uninstaller yourself: {0}"
msgstr "Avvia manualmente il programma di disinstallazione del fornitore: {0}"

#: sources.js:449
msgid "This app is on your protected list."
msgstr "L’applicazione è nell’elenco di quelle protette."

#: sources.js:451
msgid "System protection is on for this component."
msgstr "La protezione del sistema è attiva per questo componente."

#: sources.js:463
msgid "Could not find a system copy of pkexec."
msgstr "Impossibile trovare una copia di sistema di pkexec."

#: sources.js:469
msgid "Could not find a system copy of {0}."
msgstr "Impossibile trovare una copia di sistema di {0}."

#: sources.js:490
msgid "Invalid package or app ID."
msgstr "Identificativo del pacchetto o dell’applicazione non valido."

#: sources.js:511
msgid "Confirm the uninstall in Steam."
msgstr "Conferma la disinstallazione in Steam."

#: sources.js:522
msgid "For packages managed by Home Manager, edit your configuration."
msgstr "Per i pacchetti gestiti da Home Manager modifica la configurazione."

#: sources.js:535
msgid "Only the launcher will be removed. The app stays in the container."
msgstr "Verrà rimosso solo il lanciatore. L’applicazione rimane nel contenitore."

#: sources.js:541
msgid "The system launcher cannot be removed safely."
msgstr "Non è possibile rimuovere in sicurezza questo lanciatore di sistema."

#: sources.js:578
msgid "Restart to apply the change. Packages in the base image stay installed."
msgstr "Riavviare per applicare la modifica. I pacchetti dell’immagine di base restano installati."

#: sources.js:593
msgid "Unsupported package manager."
msgstr "Gestore di pacchetti non supportato."

