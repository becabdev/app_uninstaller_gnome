msgid "Unknown error."
msgstr "Errore sconosciuto."

#: extension.js:582
msgid "“{0}” still appears to be installed"
msgstr "«{0}» risulta ancora installata"

#: extension.js:583
msgid "The launcher is still present. Check the installation source."
msgstr "Il lanciatore è ancora presente. Controllare l’origine dell’installazione."

#: extension.js:589
msgid "“{0}” uninstalled"
msgstr "«{0}» è stata disinstallata"

#: extension.js:590
msgid "Restart to apply the change."
msgstr "Riavviare per applicare la modifica."

#: prefs.js:16
msgid "Settings"
msgstr "Impostazioni"

#: prefs.js:23
msgid "Support App Uninstaller"
msgstr "Sostieni App Uninstaller"

#: prefs.js:24
msgid "Your donation helps maintain and improve the extension."
msgstr "La tua donazione aiuta a mantenere e migliorare l’estensione."

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "Offrimi un caffè"

#: prefs.js:40
msgid "App menu"
msgstr "Menu dell’applicazione"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "Mostra l’origine nel menu"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "Ad esempio: «Disinstalla (Flatpak)»."

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "Nascondi la voce di menu quando non è possibile disinstallare"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "Se visibile, la voce spiega perché non è possibile rimuovere l’applicazione."

#: prefs.js:53
msgid "Menu item position"
msgstr "Posizione nel menu"

#: prefs.js:54
msgid "Before app details"
msgstr "Prima dei dettagli dell’applicazione"

#: prefs.js:54
msgid "At the bottom"
msgstr "In fondo al menu"

#: prefs.js:63
msgid "Confirmation"
msgstr "Conferma"

#: prefs.js:67
msgid "Ask before uninstalling"
msgstr "Chiedi conferma prima di disinstallare"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "Mostra l’anteprima dei pacchetti interessati"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "APT e Pacman mostrano cos’altro verrà rimosso. RPM mostra i pacchetti che dipendono dall’applicazione."

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "Mostra i comandi nella finestra di conferma"

#: prefs.js:76
msgid "Uninstall options"
msgstr "Opzioni di disinstallazione"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "Puoi modificare le opzioni ogni volta che confermi una disinstallazione."

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "Sposta i file AppImage nel cestino"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "Consenti la rimozione dei lanciatori locali"

#: prefs.js:89
msgid "This only removes the shortcut for apps such as Wine or browser apps."
msgstr "Per le applicazioni di Wine o del browser viene rimosso solo il collegamento."

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "Rimuovi dai preferiti dopo la disinstallazione"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "Mostra l’avanzamento e il completamento della disinstallazione"

#: prefs.js:97
msgid "Safety"
msgstr "Sicurezza"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "Proteggi i componenti essenziali del sistema"

#: prefs.js:112
msgid "Protected apps"
msgstr "Applicazioni protette"

#: prefs.js:113
msgid "Enter a package name, a Flatpak or Snap ID, or a .desktop filename."
msgstr "Inserisci il nome di un pacchetto, un ID Flatpak o Snap oppure il nome di un file .desktop."

#: prefs.js:117
msgid "Add an app to protect"
msgstr "Aggiungi un’applicazione da proteggere"

#: prefs.js:122
msgid "Add"
msgstr "Aggiungi"

#: prefs.js:138
msgid "Remove"
msgstr "Rimuovi"

