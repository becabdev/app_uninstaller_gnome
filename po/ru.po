msgid "Local launcher"
msgstr "Локальный ярлык"

#: sources.js:405
msgid "{0} package"
msgstr "Пакет {0}"

#: sources.js:408
msgid "Could not find a compatible package manager."
msgstr "Не удалось найти совместимый менеджер пакетов."

#: sources.js:422 sources.js:425
msgid "Manual installation"
msgstr "Ручная установка"

#: sources.js:423 sources.js:539
msgid "Run the vendor uninstaller yourself: {0}"
msgstr "Запустите программу удаления от разработчика вручную: {0}"

#: sources.js:449
msgid "This app is on your protected list."
msgstr "Это приложение есть в списке защищённых."

#: sources.js:451
msgid "System protection is on for this component."
msgstr "Для этого компонента включена системная защита."

#: sources.js:463
msgid "Could not find a system copy of pkexec."
msgstr "Не удалось найти системную копию pkexec."

#: sources.js:469
msgid "Could not find a system copy of {0}."
msgstr "Не удалось найти системную копию {0}."

#: sources.js:490
msgid "Invalid package or app ID."
msgstr "Недопустимый идентификатор пакета или приложения."

#: sources.js:511
msgid "Confirm the uninstall in Steam."
msgstr "Подтвердите удаление в Steam."

#: sources.js:522
msgid "For packages managed by Home Manager, edit your configuration."
msgstr "Если пакет управляется Home Manager, измените его конфигурацию."

#: sources.js:535
msgid "Only the launcher will be removed. The app stays in the container."
msgstr "Будет удалён только ярлык. Приложение останется в контейнере."

#: sources.js:541
msgid "The system launcher cannot be removed safely."
msgstr "Этот системный ярлык нельзя безопасно удалить."

#: sources.js:578
msgid "Restart to apply the change. Packages in the base image stay installed."
msgstr "Перезагрузите систему, чтобы применить изменение. Пакеты из базового образа останутся установленными."

#: sources.js:593
msgid "Unsupported package manager."
msgstr "Менеджер пакетов не поддерживается."

