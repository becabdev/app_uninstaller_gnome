#: extension.js:49
msgid "container"
msgstr "контейнер"

#: extension.js:50
msgid "local launcher"
msgstr "локальный ярлык"

#: extension.js:51
msgid "manual installation"
msgstr "ручная установка"

#: extension.js:52
msgid "package"
msgstr "пакет"

#: extension.js:164 extension.js:169 extension.js:226 extension.js:252
#: extension.js:484
msgid "Uninstall"
msgstr "Удалить"

#: extension.js:248
msgid "Uninstall (unavailable)"
msgstr "Удалить (недоступно)"

#: extension.js:252
msgid "Uninstall ({0})"
msgstr "Удалить ({0})"

#: extension.js:269 sources.js:76
msgid "Unknown source"
msgstr "Неизвестный источник"

#: extension.js:271
msgid "Detection error: {0}"
msgstr "Ошибка определения источника: {0}"

#: extension.js:281 sources.js:549
msgid "This installation source is unsupported."
msgstr "Этот источник установки не поддерживается."

#: extension.js:291
msgid "Local launcher removal is off in Settings."
msgstr "Удаление локальных ярлыков отключено в настройках."

#: extension.js:296
msgid "System launcher removal is off in Settings."
msgstr "Удаление системных ярлыков отключено в настройках."

#: extension.js:309
msgid "This app is already being uninstalled."
msgstr "Это приложение уже удаляется."

#: extension.js:319 extension.js:535
msgid "Cannot uninstall “{0}”"
msgstr "Не удаётся удалить «{0}»"

#: extension.js:357
msgid "Uninstall “{0}”?"
msgstr "Удалить «{0}»?"

#: extension.js:374
msgid "Administrator approval is required."
msgstr "Требуется разрешение администратора."

#: extension.js:381
msgid "Checking affected packages…"
msgstr "Проверка затронутых пакетов…"

#: extension.js:390
msgid "Dependent packages that may be removed ({0})"
msgstr "Зависимые пакеты, которые могут быть удалены ({0})"

#: extension.js:391
msgid "Other packages to be removed ({0})"
msgstr "Другие пакеты, которые будут удалены ({0})"

#: extension.js:397
msgid "Commands:"
msgstr "Команды:"

#: extension.js:438 prefs.js:82
msgid "Also delete data and settings"
msgstr "Удалять также данные и настройки"

#: extension.js:450 prefs.js:84
msgid "Also remove unused dependencies"
msgstr "Удалять также неиспользуемые зависимости"

#: extension.js:475
msgid "Cancel"
msgstr "Отмена"

#: extension.js:492 extension.js:568
msgid "Failed to uninstall “{0}”"
msgstr "Не удалось удалить «{0}»"

#: extension.js:514
msgid "Authentication cancelled or denied."
msgstr "Аутентификация отменена или отклонена."

#: extension.js:515
msgid "exit code {0}"
msgstr "код завершения {0}"

#: extension.js:552
msgid "Uninstalling “{0}”…"
msgstr "Удаление «{0}»…"

#: extension.js:569
msgid "Unknown error."
msgstr "Неизвестная ошибка."

#: extension.js:582
msgid "“{0}” still appears to be installed"
msgstr "Похоже, «{0}» всё ещё установлено"

#: extension.js:583
msgid "The launcher is still present. Check the installation source."
msgstr "Ярлык остался на месте. Проверьте источник установки."

#: extension.js:589
msgid "“{0}” uninstalled"
msgstr "Приложение «{0}» удалено"

#: extension.js:590
msgid "Restart to apply the change."
msgstr "Перезагрузите систему, чтобы применить изменение."

#: prefs.js:16
msgid "Settings"
msgstr "Настройки"

#: prefs.js:23
msgid "Support App Uninstaller"
msgstr "Поддержите App Uninstaller"

#: prefs.js:24
msgid "Your donation helps maintain and improve the extension."
msgstr "Ваше пожертвование помогает поддерживать и улучшать расширение."

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "Угостите меня кофе"

#: prefs.js:40
msgid "App menu"
msgstr "Меню приложения"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "Показывать источник установки в меню"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "Например: «Удалить (Flatpak)»."

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "Скрывать пункт меню, если удаление недоступно"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "Если пункт виден, по нажатию он объяснит, почему приложение нельзя удалить."

#: prefs.js:53
msgid "Menu item position"
msgstr "Положение в меню"

#: prefs.js:54
msgid "Before app details"
msgstr "Перед сведениями о приложении"

#: prefs.js:54
msgid "At the bottom"
msgstr "Внизу меню"

#: prefs.js:63
msgid "Confirmation"
msgstr "Подтверждение"

#: prefs.js:67
msgid "Ask before uninstalling"
msgstr "Запрашивать подтверждение перед удалением"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "Показывать затронутые пакеты"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "APT и Pacman показывают, что ещё будет удалено. RPM показывает пакеты, которые зависят от приложения."

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "Показывать команды в окне подтверждения"

#: prefs.js:76
msgid "Uninstall options"
msgstr "Параметры удаления"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "Эти параметры можно изменить при подтверждении каждого удаления."

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "Перемещать файлы AppImage в корзину"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "Разрешить удаление локальных ярлыков"

#: prefs.js:89
msgid "This only removes the shortcut for apps such as Wine or browser apps."
msgstr "Для приложений Wine или приложений в браузере удаляется только ярлык."

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "Убирать из избранного после удаления"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "Показывать ход и завершение удаления"

#: prefs.js:97
msgid "Safety"
msgstr "Безопасность"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "Защищать важные компоненты системы"

#: prefs.js:112
msgid "Protected apps"
msgstr "Защищённые приложения"

#: prefs.js:113
msgid "Enter a package name, a Flatpak or Snap ID, or a .desktop filename."
msgstr "Введите имя пакета, идентификатор Flatpak или Snap либо имя файла .desktop."

#: prefs.js:117
msgid "Add an app to protect"
msgstr "Добавить приложение для защиты"

#: prefs.js:122
msgid "Add"
msgstr "Добавить"

#: prefs.js:138
msgid "Remove"
msgstr "Убрать"

