msgid "Container “{0}” (Distrobox or Toolbox)"
msgstr "Контейнер «{0}» (Distrobox или Toolbox)"

#: sources.js:330
msgid "The launcher is not in your home directory."
msgstr "Ярлык находится за пределами домашней папки."

#: sources.js:356
msgid "NixOS configuration"
msgstr "Конфигурация NixOS"

#: sources.js:357
msgid "Remove this app from your NixOS configuration and rebuild the system."
msgstr "Уберите приложение из конфигурации NixOS и пересоберите систему."

#: sources.js:360
msgid "Could not find nix or nix-env."
msgstr "Не удалось найти nix или nix-env."

#: sources.js:372
msgid "Guix was not found."
msgstr "Guix не найден."

