#: prefs.js:23
msgid "Support App Uninstaller"
msgstr "Soutenir App Uninstaller"

#: prefs.js:24
msgid "Your donation helps maintain and improve the extension."
msgstr "Votre don aide à maintenir et à améliorer l’extension."

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "Offrez-moi un café"

#: prefs.js:40
msgid "App menu"
msgstr "Menu des applications"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "Afficher la source dans le menu"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "Par exemple : « Désinstaller (Flatpak) »."

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "Masquer l’option quand la désinstallation est indisponible"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "Si elle est affichée, l’option explique pourquoi l’application ne peut pas être supprimée."

#: prefs.js:53
msgid "Menu item position"
msgstr "Position de l’option dans le menu"

#: prefs.js:54
msgid "Before app details"
