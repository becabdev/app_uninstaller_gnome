#: prefs.js:54
msgid "At the bottom"
msgstr "En bas du menu"

#: prefs.js:63
msgid "Confirmation"
msgstr "Confirmation"

#: prefs.js:67
msgid "Ask before uninstalling"
msgstr "Demander confirmation avant de désinstaller"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "Afficher les paquets concernés"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "APT et Pacman indiquent les autres paquets qui seront supprimés. RPM indique ceux qui dépendent de l’application."

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "Afficher les commandes dans la boîte de confirmation"

#: prefs.js:76
msgid "Uninstall options"
msgstr "Options de désinstallation"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "Vous pouvez modifier ces options à chaque désinstallation."

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "Mettre les fichiers AppImage à la corbeille"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "Autoriser la suppression des lanceurs locaux"

#: prefs.js:89
msgid "Remove local shortcuts and, when identified, their standalone app files."
msgstr "Supprime les raccourcis locaux ainsi que les fichiers des applications autonomes identifiées."

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "Retirer des favoris après la désinstallation"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "Afficher la progression et le résultat de la désinstallation"

#: prefs.js:97
msgid "Safety"
msgstr "Sécurité"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "Protéger les composants système essentiels"

#: prefs.js:112
msgid "Protected apps"
msgstr "Applications protégées"

