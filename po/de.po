msgid "Cannot uninstall “{0}”"
msgstr "»{0}« kann nicht deinstalliert werden"

#: extension.js:357
msgid "Uninstall “{0}”?"
msgstr "»{0}« deinstallieren?"

#: extension.js:374
msgid "Administrator approval is required."
msgstr "Eine Bestätigung durch einen Administrator ist erforderlich."

#: extension.js:381
msgid "Checking affected packages…"
msgstr "Betroffene Pakete werden ermittelt …"

#: extension.js:390
msgid "Dependent packages that may be removed ({0})"
msgstr "Abhängige Pakete, die möglicherweise entfernt werden ({0})"

