#: extension.js:291
msgid "Local launcher removal is off in Settings."
msgstr "Das Entfernen lokaler Starter ist in den Einstellungen deaktiviert."

#: extension.js:296
msgid "System launcher removal is off in Settings."
msgstr "Das Entfernen systemweiter Starter ist in den Einstellungen deaktiviert."

#: extension.js:309
msgid "This app is already being uninstalled."
msgstr "Diese Anwendung wird bereits deinstalliert."

