msgstr "Weitere Pakete, die entfernt werden ({0})"

#: extension.js:397
msgid "Commands:"
msgstr "Befehle:"

#: extension.js:438 prefs.js:82
msgid "Also delete data and settings"
msgstr "Auch Daten und Einstellungen löschen"

#: extension.js:450 prefs.js:84
msgid "Also remove unused dependencies"
msgstr "Auch ungenutzte Abhängigkeiten entfernen"

#: extension.js:475
msgid "Cancel"
msgstr "Abbrechen"

