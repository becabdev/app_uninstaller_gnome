#: prefs.js:16
msgid "Settings"
msgstr "Einstellungen"

#: prefs.js:23
msgid "Support App Uninstaller"
msgstr "App Uninstaller unterstützen"

#: prefs.js:24
msgid "Your donation helps maintain and improve the extension."
msgstr "Ihre Spende hilft, die Erweiterung zu pflegen und weiterzuentwickeln."

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "Spendieren Sie mir einen Kaffee"

#: prefs.js:40
msgid "App menu"
msgstr "Anwendungsmenü"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "Installationsquelle im Menü anzeigen"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "Zum Beispiel: »Deinstallieren (Flatpak)«."

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "Menüeintrag ausblenden, wenn keine Deinstallation möglich ist"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "Der sichtbare Eintrag erklärt, warum sich die Anwendung nicht entfernen lässt."

#: prefs.js:53
msgid "Menu item position"
msgstr "Position im Menü"

#: prefs.js:54
msgid "Before app details"
msgstr "Vor den Anwendungsdetails"

#: prefs.js:54
msgid "At the bottom"
msgstr "Am Ende des Menüs"

#: prefs.js:63
msgid "Confirmation"
msgstr "Bestätigung"

#: prefs.js:67
msgid "Ask before uninstalling"
msgstr "Vor der Deinstallation nachfragen"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "Betroffene Pakete anzeigen"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "APT und Pacman zeigen, welche Pakete ebenfalls entfernt werden. RPM zeigt Pakete, die von der Anwendung abhängen."

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "Befehle im Bestätigungsdialog anzeigen"

#: prefs.js:76
msgid "Uninstall options"
msgstr "Optionen für die Deinstallation"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "Sie können diese Optionen bei jeder Deinstallation ändern."

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "AppImage-Dateien in den Papierkorb verschieben"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "Entfernen lokaler Starter erlauben"

#: prefs.js:89
msgid "This only removes the shortcut for apps such as Wine or browser apps."
msgstr "Bei Wine- oder Browseranwendungen wird nur die Verknüpfung entfernt."

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "Nach der Deinstallation aus den Favoriten entfernen"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "Fortschritt und Abschluss der Deinstallation anzeigen"

#: prefs.js:97
msgid "Safety"
msgstr "Sicherheit"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "Wichtige Systemkomponenten schützen"

#: prefs.js:112
msgid "Protected apps"
msgstr "Geschützte Anwendungen"

#: prefs.js:113
msgid "Enter a package name, a Flatpak or Snap ID, or a .desktop filename."
msgstr "Geben Sie einen Paketnamen, eine Flatpak- oder Snap-ID oder den Namen einer .desktop-Datei ein."

#: prefs.js:117
msgid "Add an app to protect"
msgstr "Zu schützende Anwendung hinzufügen"

#: prefs.js:122
msgid "Add"
msgstr "Hinzufügen"

#: prefs.js:138
msgid "Remove"
msgstr "Entfernen"

