msgid "Your donation helps maintain and improve the extension."
msgstr "Tu donación ayuda a mantener y mejorar la extensión."

#: prefs.js:35
msgid "Buy me a coffee"
msgstr "Invítame a un café"

#: prefs.js:40
msgid "App menu"
msgstr "Menú de la aplicación"

#: prefs.js:45
msgid "Show the source in the menu"
msgstr "Mostrar el origen en el menú"

#: prefs.js:46
msgid "For example: “Uninstall (Flatpak)”."
msgstr "Por ejemplo: «Desinstalar (Flatpak)»."

#: prefs.js:48
msgid "Hide the menu item when uninstalling is unavailable"
msgstr "Ocultar la opción si no se puede desinstalar la aplicación"

#: prefs.js:49
msgid "If shown, the item explains why the app can't be removed."
msgstr "Si está visible, la opción explica por qué no se puede eliminar la aplicación."

