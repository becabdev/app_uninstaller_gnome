msgid "Ask before uninstalling"
msgstr "Pedir confirmación antes de desinstalar"

#: prefs.js:69
msgid "Preview affected packages"
msgstr "Mostrar los paquetes afectados"

#: prefs.js:70
msgid "APT and Pacman show what else will be removed. RPM shows packages that depend on the app."
msgstr "APT y Pacman muestran qué más se eliminará. RPM muestra los paquetes que dependen de la aplicación."

#: prefs.js:72
msgid "Show commands in the confirmation dialog"
msgstr "Mostrar los comandos en el diálogo de confirmación"

#: prefs.js:76
msgid "Uninstall options"
msgstr "Opciones de desinstalación"

#: prefs.js:77
msgid "You can change the removal options each time you confirm an uninstall."
msgstr "Puedes cambiar estas opciones cada vez que confirmes una desinstalación."

#: prefs.js:86
msgid "Move AppImage files to the Trash"
msgstr "Mover los archivos AppImage a la papelera"

#: prefs.js:88
msgid "Allow removal of local launchers"
msgstr "Permitir eliminar lanzadores locales"

#: prefs.js:89
msgid "This only removes the shortcut for apps such as Wine or browser apps."
msgstr "En las aplicaciones de Wine o del navegador solo se elimina el acceso directo."

#: prefs.js:91
msgid "Remove from Favorites after uninstalling"
msgstr "Quitar de favoritos al desinstalar"

#: prefs.js:93
msgid "Show uninstall progress and completion"
msgstr "Mostrar el progreso y avisar al terminar"

#: prefs.js:97
msgid "Safety"
msgstr "Seguridad"

#: prefs.js:102
msgid "Protect essential system components"
msgstr "Proteger los componentes esenciales del sistema"

#: prefs.js:112
msgid "Protected apps"
